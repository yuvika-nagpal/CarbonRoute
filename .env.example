# =================================================================
# CarbonRoute Full-Stack Platform Environment Variables
# =================================================================

# Server Environment
NODE_ENV=development
PORT=5000
CORS_ORIGIN=http://localhost:5173

# Authentication Security (Never commit secrets to version control)
JWT_SECRET=carbonroute_super_secure_jwt_production_secret_2026_key
JWT_EXPIRES_IN=7d

# Initial Admin Credentials (Generated automatically on first seed)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@carbonroute.org
ADMIN_PASSWORD=CarbonRoute2026!Secure

# Object Storage Configuration ('local' or 's3')
STORAGE_TYPE=local
LOCAL_STORAGE_DIR=./storage/uploads

# AWS S3 / Cloudflare R2 / MinIO Compatible Settings (Required if STORAGE_TYPE=s3)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET_NAME=carbonroute-presentations
AWS_ENDPOINT=
AWS_S3_FORCE_PATH_STYLE=false
